{
  "name": "vue-webpack-shadow",
  "version": "0.1.0",
  "description": "Webpack 5 plugin for Vue 3 SFC <style shadow> injection into ShadowRoot",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.cjs",
      "import": "./dist/runtime.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.2.0",
    "webpack": "^5.0.0"
  },
  "dependencies": {
    "magic-string": "^0.30.10"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}

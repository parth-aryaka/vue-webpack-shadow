{\n  "name": "vue-webpack-shadow",\n  "version": "0.1.0",\n  "description": "Webpack 5 plugin for Vue 3 SFC <style shadow> injection into ShadowRoot",\n  "main": "dist/index.cjs",\n  "module": "dist/index.mjs",\n  "types": "dist/index.d.ts",\n  "files": [\n    "dist"\n  ],\n  "exports": {\n    ".": {\n      "types": "./dist/index.d.ts",\n      "require": "./dist/index.cjs",\n      "import": "./dist/index.mjs"\n    },\n    "./runtime": {\n      "types": "./dist/runtime.d.ts",\n      "require": "./dist/runtime.cjs",\n      "import": "./dist/runtime.mjs"\n    }\n  },\n  "scripts": {\n    "build": "tsup",\n    "typecheck": "tsc -p tsconfig.json --noEmit",\n    "prepublishOnly": "npm run typecheck && npm run build"\n  },\n  "peerDependencies": {\n    "@vue/compiler-sfc": "^3.2.0",\n    "webpack": "^5.0.0"\n  },\n  "dependencies": {\n    "magic-string": "^0.30.10"\n  },\n  "devDependencies": {\n    "@types/node": "^20.0.0",\n    "tsup": "^8.0.0",\n    "typescript": "^5.4.0"\n  },\n  "license": "MIT"\n}